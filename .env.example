# Copy to .env.local for development. Never commit real values.
# With both keys set the app processes YouTube links live; without them it serves saved fixtures.
YOUTUBE_API_KEY=
OPENROUTER_API_KEY=
SUPADATA_API_KEY=           # M3 (Instagram)
INSTAGRAM_ENABLED=true

# Optional (defaults shown)
# REELISH_PIPELINE=live      # or "fixtures" to force the offline preview
# REELISH_DB_PATH=data/reelish.db
# DAILY_AI_BUDGET_USD=1
# MAX_JOB_COST_USD=0.12
# RATE_LIMIT_PER_HOUR=10
# TRUST_PROXY=false          # true only behind our own Nginx (uses X-Forwarded-For for rate limits)
